{% extends "base.html" %}

{% block content %}

<div class="admin-page" style="max-width:1100px;margin:40px auto;padding:0 20px;">

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;">

        <div>
            <div style="color:#c9a24a;font-size:12px;font-weight:700;letter-spacing:2px;">
                ALBUM EDITOR
            </div>

            <h1 style="margin:8px 0;">
                {{ album['title'] }}
            </h1>

            <p style="color:#929292;">
                {{ tracks|length }} tracks · Drag tracks to rearrange them.
            </p>
        </div>

        <a href="{{ url_for('admin_albums') }}"
           class="admin-publish-button"
           style="text-decoration:none;">
            ← ALBUMS
        </a>

    </div>


    <!-- ALBUM DETAILS -->

    <div style="background:#111;border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:25px;margin-bottom:30px;">

        <h2>Album Details</h2>

        <form method="POST"
              action="{{ url_for('save_album_manager', album_id=album['id']) }}"
              enctype="multipart/form-data">

            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:15px;">

                <div class="admin-field">
                    <label>Album Name</label>
                    <input name="album"
                           value="{{ album['title'] }}"
                           required>
                </div>

                <div class="admin-field">
                    <label>Artist</label>
                    <input name="artist"
                           value="{{ album['artist'] }}"
                           required>
                </div>

                <div class="admin-field">
                    <label>Genre</label>
                    <input name="genre"
                           value="{{ album['genre'] }}">
                </div>

            </div>

            <div class="admin-field" style="margin-top:15px;">
                <label>Change Artwork</label>
                <input type="file"
                       name="cover"
                       accept=".jpg,.jpeg,.png,.webp">
            </div>

            <button type="submit"
                    class="admin-publish-button">
                SAVE ALBUM
            </button>

        </form>

    </div>


    <!-- ADD TRACKS -->

    <div style="background:#111;border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:25px;margin-bottom:30px;">

        <h2>+ Add More Tracks</h2>

        <form method="POST"
              action="{{ url_for('add_album_tracks', album_id=album['id']) }}"
              enctype="multipart/form-data">

            <input type="file"
                   name="audio"
                   accept=".mp3,.wav,.m4a,.aac,.ogg"
                   multiple
                   required>

            <button type="submit"
                    class="admin-publish-button"
                    style="margin-top:15px;">
                ADD TRACKS
            </button>

        </form>

    </div>


    <!-- TRACK LIST -->

    <div style="background:#111;border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:25px;">

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">

            <div>
                <h2 style="margin:0;">
                    All Tracks
                </h2>

                <p style="color:#929292;margin:6px 0 0;">
                    Drag and drop to change the track order.
                </p>
            </div>

            <strong id="saveStatus"
                    style="color:#c9a24a;">
            </strong>

        </div>


        <div id="trackList">

            {% for song in tracks %}

            <div class="album-track"
                 draggable="true"
                 data-id="{{ song['id'] }}"
                 style="background:#181818;border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:15px;margin-bottom:10px;">

                <div style="display:flex;align-items:center;gap:15px;">

                    <div class="track-number"
                         style="font-weight:800;min-width:30px;">
                        {{ loop.index }}
                    </div>

                    <div style="font-size:22px;cursor:grab;">
                        ☷
                    </div>

                    <div style="flex:1;min-width:0;">

                        <strong>
                            {{ song['title'] }}
                        </strong>

                        <div style="color:#929292;font-size:13px;">
                            {{ song['artist'] }}
                        </div>

                    </div>

                    <button type="button"
                            class="edit-track-button"
                            onclick="toggleTrack({{ song['id'] }})">
                        EDIT
                    </button>

                    <form method="POST"
                          action="{{ url_for('delete_album_track', album_id=album['id'], song_id=song['id']) }}"
                          onsubmit="return confirm('Delete this track?');">

                        <button type="submit"
                                style="background:none;border:0;color:#d66;cursor:pointer;">
                            DELETE
                        </button>

                    </form>

                </div>


                <form id="track-edit-{{ song['id'] }}"
                      method="POST"
                      action="{{ url_for('save_album_track', album_id=album['id'], song_id=song['id']) }}"
                      style="display:none;margin-top:15px;padding-top:15px;border-top:1px solid rgba(255,255,255,.08);">

                    <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px;">

                        <input name="title"
                               value="{{ song['title'] }}"
                               placeholder="Song title"
                               required>

                        <input name="artist"
                               value="{{ song['artist'] }}"
                               placeholder="Artist"
                               required>

                        <input name="genre"
                               value="{{ song['genre'] }}"
                               placeholder="Genre">

                    </div>

                    <button type="submit"
                            class="admin-publish-button"
                            style="margin-top:12px;">
                        SAVE TRACK
                    </button>

                </form>

            </div>

            {% endfor %}

        </div>

        {% if not tracks %}

        <div style="padding:30px;color:#929292;text-align:center;">
            This album has no tracks yet.
        </div>

        {% endif %}

    </div>

</div>


<script>

function toggleTrack(id) {

    const form = document.getElementById("track-edit-" + id);

    form.style.display =
        form.style.display === "none"
            ? "block"
            : "none";
}


const list = document.getElementById("trackList");

let dragged = null;

list.querySelectorAll(".album-track").forEach(function (item) {

    item.addEventListener("dragstart", function () {
        dragged = this;
        this.style.opacity = "0.5";
    });

    item.addEventListener("dragend", async function () {

        this.style.opacity = "1";

        const ids = [...list.querySelectorAll(".album-track")]
            .map(item => Number(item.dataset.id));

        [...list.querySelectorAll(".track-number")]
            .forEach((number, index) => {
                number.textContent = index + 1;
            });

        const status = document.getElementById("saveStatus");

        status.textContent = "Saving...";

        try {

            const response = await fetch(
                "{{ url_for('reorder_album_manager', album_id=album['id']) }}",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        song_ids: ids
                    })
                }
            );

            if (!response.ok) {
                throw new Error("Failed");
            }

            status.textContent = "✓ Order saved";

            setTimeout(function () {
                status.textContent = "";
            }, 2000);

        } catch (error) {

            status.textContent = "Could not save order";

        }

    });

    item.addEventListener("dragover", function (event) {

        event.preventDefault();

        if (!dragged || dragged === this) {
            return;
        }

        const rect = this.getBoundingClientRect();

        if (event.clientY < rect.top + rect.height / 2) {
            list.insertBefore(dragged, this);
        } else {
            list.insertBefore(dragged, this.nextSibling);
        }

    });

});

</script>

{% endblock %}

<style>
.delete-album-section {
    margin-top: 50px;
    padding-top: 25px;
    border-top: 1px solid rgba(255,255,255,.08);
}

.delete-album-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    background: transparent;
    border: 1px solid #7a2525;
    color: #d66;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    cursor: pointer;
}

.delete-album-btn:hover {
    background: #7a2525;
    color: #fff;
}
</style>

<div class="delete-album-section">
    <form method="POST"
          action="{{ url_for('delete_album', album_id=album.id) }}"
          onsubmit="return confirm('DELETE THIS ENTIRE ALBUM? All tracks in this album will also be deleted. This cannot be undone.');">

        <button type="submit" class="delete-album-btn">
            DELETE WHOLE ALBUM
        </button>

    </form>
</div>
