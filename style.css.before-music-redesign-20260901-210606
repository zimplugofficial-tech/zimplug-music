    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 8px;
}

.report-privacy {
    display: flex;
    gap: 9px;
    align-items: center;
}

.report-privacy span {
    font-size: 12px;
}

.report-privacy p {
    color: #5e5e5e;
    font-size: 10px;
    line-height: 1.4;
    max-width: 190px;
    margin: 0;
}

.report-submit {
    min-width: 190px;
    border: 1px solid var(--gold);
    background: var(--gold);
    color: #080808;
    padding: 15px 19px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    font-family: inherit;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
    transition: .2s ease;
}

.report-submit strong {
    font-size: 18px;
    line-height: 1;
}

.report-submit:hover {
    background: var(--gold-light);
    transform: translateY(-1px);
}


/* BOTTOM */

.report-bottom {
    margin-top: 35px;
    padding: 25px 0;
    border-top: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.report-bottom > div:first-child {
    display: flex;
    align-items: flex-start;
    gap: 18px;
}

.report-bottom-number {
    color: var(--gold);
    font-size: 11px;
    font-weight: 900;
}

.report-bottom strong {
    display: block;
    color: #ddd;
    font-size: 12px;
    margin-bottom: 5px;
}

.report-bottom p {
    margin: 0;
    color: #666;
    font-size: 11px;
    line-height: 1.5;
    max-width: 620px;
}

.report-bottom-brand {
    text-align: right;
    color: #333;
    font-size: 16px;
    font-weight: 900;
    line-height: .85;
    letter-spacing: -.05em;
}

.report-bottom-brand span {
    color: var(--gold);
    font-size: 8px;
    letter-spacing: .2em;
}


/* MOBILE */

@media (max-width: 850px) {

    .report-hero {
        padding: 65px 20px 55px;
    }

    .report-container {
        width: min(100% - 30px, 650px);
        margin-top: 35px;
    }

    .report-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .report-sidebar {
        padding-top: 0;
    }

    .report-sidebar-text {
        margin-bottom: 25px;
    }

    .report-form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .report-form-footer {
        align-items: stretch;
        flex-direction: column;
    }

    .report-privacy {
        align-items: flex-start;
    }

    .report-submit {
        width: 100%;
    }

    .report-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .report-bottom-brand {
        text-align: left;
    }
}


@media (max-width: 520px) {

    .report-hero h1 {
        font-size: 46px;
    }

    .report-hero p {
        font-size: 14px;
    }

    .report-card-header,
    .report-card form {
        padding: 22px 18px;
    }

    .report-card-header h2 {
        font-size: 19px;
    }

    .report-card-mark {
        display: none;
    }

}


/* =========================================================
   LEGAL & DMCA — PREMIUM PAGE
   ========================================================= */

.legal-page {
    min-height: calc(100vh - 80px);
    background:
        radial-gradient(circle at 75% 5%, rgba(201,162,74,.08), transparent 30%),
        var(--black);
    padding-bottom: 100px;
}

.legal-hero {
    position: relative;
    overflow: hidden;
    padding: 90px 24px 85px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.legal-hero-inner {
    width: min(1180px, 100%);
    margin: auto;
    position: relative;
    z-index: 2;
}

.legal-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .18em;
    margin-bottom: 24px;
}

.legal-badge span {
    width: 7px;
    height: 7px;
    background: var(--gold);
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(201,162,74,.6);
}

.legal-hero h1 {
    margin: 0;
    color: white;
    font-size: clamp(55px, 8vw, 105px);
    line-height: .87;
    letter-spacing: -.065em;
    font-weight: 900;
}

.legal-hero h1 em {
    color: var(--gold);
    font-style: normal;
}

.legal-hero p {
    max-width: 590px;
    margin: 30px 0 0;
    color: #8a8a8a;
    font-size: 16px;
    line-height: 1.7;
}

.legal-hero-word {
    position: absolute;
    right: -15px;
    bottom: -60px;
    color: rgba(255,255,255,.025);
    font-size: clamp(120px, 20vw, 290px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -.09em;
}


/* CONTAINER */

.legal-container {
    width: min(1050px, calc(100% - 48px));
    margin: 60px auto 0;
}


/* INTRO */

.legal-intro {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 25px;
    padding-bottom: 65px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.legal-index,
.legal-number {
    color: var(--gold);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .1em;
}

.legal-intro span {
    display: block;
    color: #666;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .18em;
    margin-bottom: 12px;
}

.legal-intro h2 {
    margin: 0;
    color: white;
    font-size: clamp(30px, 4vw, 45px);
    line-height: 1.05;
    letter-spacing: -.045em;
}

.legal-intro p {
    max-width: 700px;
    color: #858585;
    font-size: 14px;
    line-height: 1.8;
    margin: 22px 0 0;
}


/* SECTIONS */

.legal-section {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 25px;
    padding: 65px 0;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.legal-content {
    max-width: 780px;
}

.legal-label {
    display: block;
    color: var(--gold);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .18em;
    margin-bottom: 12px;
}

.legal-content h2 {
    margin: 0 0 18px;
    color: white;
    font-size: 28px;
    letter-spacing: -.035em;
}

.legal-content p {
    color: #858585;
    font-size: 13px;
    line-height: 1.8;
    margin: 0 0 14px;
}

.legal-content strong {
    color: #ddd;
}


/* HIGHLIGHT */

.legal-highlight {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 25px;
    padding: 18px 20px;
    background: rgba(201,162,74,.045);
    border-left: 2px solid var(--gold);
}

.legal-highlight strong {
    color: var(--gold-light);
    font-size: 12px;
}

.legal-highlight span {
    color: #666;
    font-size: 11px;
}


/* FEATURED DMCA */

.legal-section-featured {
    margin: 0 -30px;
    padding-left: 30px;
    padding-right: 30px;
    background:
        linear-gradient(
            90deg,
            rgba(201,162,74,.045),
            transparent 70%
        );
    border-left: 1px solid rgba(201,162,74,.15);
}


/* REQUIREMENTS */

.legal-requirements {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 30px;
    border-top: 1px solid rgba(255,255,255,.08);
    border-left: 1px solid rgba(255,255,255,.08);
}

.legal-requirements > div {
    padding: 20px;
    border-right: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.legal-requirements span {
    display: block;
    color: var(--gold);
    font-size: 9px;
    font-weight: 900;
    margin-bottom: 10px;
}

.legal-requirements strong {
    display: block;
    color: #ddd;
    font-size: 12px;
    margin-bottom: 7px;
}

.legal-requirements p {
    color: #666;
    font-size: 11px;
    line-height: 1.55;
    margin: 0;
}


/* ACTION */

.legal-action {
    margin-top: 30px;
    padding: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: #0b0b0b;
    border: 1px solid rgba(255,255,255,.08);
}

.legal-action small {
    display: block;
    color: #555;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .18em;
    margin-bottom: 5px;
}

.legal-action strong {
    color: #ddd;
    font-size: 13px;
}

.legal-action a,
.legal-contact a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 13px 16px;
    background: var(--gold);
    color: #080808;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .1em;
    text-decoration: none;
    transition: .2s ease;
}

.legal-action a:hover,
.legal-contact a:hover {
    background: var(--gold-light);
    transform: translateY(-1px);
}

.legal-action a span,
.legal-contact a span {
    font-size: 16px;
}


/* CONTACT */

.legal-contact {
    margin-top: 25px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid rgba(255,255,255,.08);
    background: #0c0c0c;
}

.legal-contact > div span {
    display: block;
    color: #555;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .16em;
    margin-bottom: 7px;
}

.legal-contact > div strong {
    color: #ddd;
    font-size: 13px;
}


/* FOOTER */

.legal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 35px 0;
}

.legal-footer strong {
    color: #444;
    font-size: 13px;
    letter-spacing: .08em;
}

.legal-footer p {
    margin: 7px 0 0;
    color: #555;
    font-size: 10px;
}

.legal-footer-links {
    display: flex;
    gap: 22px;
}

.legal-footer-links a {
    color: #666;
    text-decoration: none;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .12em;
}

.legal-footer-links a:hover {
    color: var(--gold);
}


/* MOBILE */

@media (max-width: 700px) {

    .legal-hero {
        padding: 65px 20px;
    }

    .legal-container {
        width: min(100% - 30px, 600px);
        margin-top: 40px;
    }

    .legal-intro,
    .legal-section {
        grid-template-columns: 38px 1fr;
        gap: 14px;
        padding: 45px 0;
    }

    .legal-section-featured {
        margin: 0;
        padding-left: 18px;
        padding-right: 18px;
    }

    .legal-requirements {
        grid-template-columns: 1fr;
    }

    .legal-action,
    .legal-contact,
    .legal-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .legal-action a,
    .legal-contact a {
        width: 100%;
        box-sizing: border-box;
    }

    .legal-footer-links {
        flex-wrap: wrap;
    }
}

@media (max-width: 450px) {

    .legal-hero h1 {
        font-size: 52px;
    }

    .legal-hero p {
        font-size: 14px;
    }

    .legal-content h2 {
        font-size: 24px;
    }

    .legal-contact > div strong {
        font-size: 11px;
    }
}
