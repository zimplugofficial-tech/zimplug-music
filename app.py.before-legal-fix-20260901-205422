@app.route("/report", methods=["GET", "POST"])
def report():
    if request.method == "POST":
        report_type = request.form.get("type", "").strip()
        name = request.form.get("name", "").strip()
        email = request.form.get("email", "").strip()
        subject = request.form.get("subject", "").strip()
        message = request.form.get("message", "").strip()

        if not report_type or not subject or not message:
            return render_template(
                "report.html",
                error="Please select a report type and complete the subject and message."
            )

        import os
        import smtplib
        from email.message import EmailMessage

        smtp_user = os.getenv("SMTP_USER", "zimplugofficial@gmail.com")
        smtp_password = os.getenv("SMTP_PASSWORD", "")
        report_email = os.getenv("REPORT_EMAIL", "zimplugofficial@gmail.com")

        if not smtp_password:
            return render_template(
                "report.html",
                error="Email service is not configured yet. Please try again later."
            )

        email_message = EmailMessage()
        email_message["Subject"] = f"ZimPlug Music Report: {subject}"
        email_message["From"] = smtp_user
        email_message["To"] = report_email

        if email:
            email_message["Reply-To"] = email

        email_message.set_content(
            f"""ZIMPLUG MUSIC REPORT

Report Type: {report_type}
Name: {name or "Not provided"}
Email: {email or "Not provided"}

Subject:
{subject}

Message:
{message}
"""
        )

        try:
            with smtplib.SMTP_SSL("smtp.gmail.com", 465) as smtp:
                smtp.login(smtp_user, smtp_password)
                smtp.send_message(email_message)

            return render_template(
                "report.html",
                success="Your report has been submitted successfully. Thank you for helping us improve ZimPlug Music."
            )

        except Exception:
            return render_template(
                "report.html",
                error="We couldn't send your report right now. Please try again later."
            )

    return render_template("report.html")

