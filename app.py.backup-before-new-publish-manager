@app.route("/admin/upload", methods=["GET", "POST"])
@admin_required
def admin_upload():
    if request.method == "GET":
        return render_template("admin_upload.html")

    title = request.form.get("title", "").strip()
    artist = request.form.get("artist", "").strip()
    genre = request.form.get("genre", "Other").strip()
    album = request.form.get("album", "").strip()

    audio_file = request.files.get("audio")
    cover_file = request.files.get("cover")

    if not title or not artist or not audio_file or not audio_file.filename:
        return "Title, artist and audio are required.", 400

    audio_ext = Path(audio_file.filename).suffix.lower()

    if audio_ext not in ALLOWED_AUDIO:
        return (
            f"Unsupported audio format: {audio_ext}. "
            f"Allowed formats: {', '.join(sorted(ALLOWED_AUDIO))}"
        ), 400

    safe_audio = secure_filename(audio_file.filename)

    if not safe_audio:
        return "Invalid audio filename.", 400

    # Prevent two uploads with the same filename from overwriting each other.
    audio_stem = Path(safe_audio).stem
    audio_suffix = Path(safe_audio).suffix
    candidate = safe_audio
    counter = 1

    while (MUSIC_DIR / candidate).exists():
        candidate = f"{audio_stem}-{counter}{audio_suffix}"
        counter += 1

    safe_audio = candidate
    audio_path = MUSIC_DIR / safe_audio

    try:
        audio_file.save(audio_path)

        cover_name = ""

        if cover_file and cover_file.filename:
            cover_ext = Path(cover_file.filename).suffix.lower()

            if cover_ext in ALLOWED_IMAGE:
                safe_cover = secure_filename(cover_file.filename)

                if safe_cover:
                    cover_stem = Path(safe_cover).stem
                    cover_suffix = Path(safe_cover).suffix
                    cover_candidate = safe_cover
                    cover_counter = 1

                    images_dir = BASE_DIR / "static" / "images"
                    images_dir.mkdir(parents=True, exist_ok=True)

                    while (images_dir / cover_candidate).exists():
                        cover_candidate = (
                            f"{cover_stem}-{cover_counter}{cover_suffix}"
                        )
                        cover_counter += 1

                    cover_name = cover_candidate
                    cover_path = images_dir / cover_name
                    cover_file.save(cover_path)

        connection = db()

        connection.execute(
            """
            INSERT INTO songs(
                title,
                artist,
                genre,
                album,
                cover,
                audio
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                title,
                artist,
                genre,
                album,
                cover_name,
                safe_audio,
            ),
        )

        connection.commit()
        connection.close()

    except Exception as error:
        try:
            if audio_path.exists():
                audio_path.unlink()
        except Exception:
            pass

        print(f"ADMIN UPLOAD ERROR: {error}")
        return f"Upload failed: {error}", 500

    return redirect(url_for("admin"))





