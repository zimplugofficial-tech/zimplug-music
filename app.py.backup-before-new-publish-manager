@app.route("/admin/albums/<int:album_id>/add", methods=["POST"])
@admin_required
def add_album_tracks(album_id):
    ensure_album_schema()

    audio_files = [
        file
        for file in request.files.getlist("audio")
        if file and file.filename
    ]

    if not audio_files:
        return "Select at least one track.", 400

    connection = db()

    album = connection.execute(
        "SELECT * FROM albums WHERE id = ?",
        (album_id,)
    ).fetchone()

    if not album:
        connection.close()
        return "Album not found.", 404

    last = connection.execute(
        """
        SELECT COALESCE(MAX(track_number), 0) AS max_track
        FROM songs
        WHERE album_id = ?
        """,
        (album_id,)
    ).fetchone()

    next_track = last["max_track"] + 1

    saved = []

    try:

        for audio in audio_files:

            ext = Path(audio.filename).suffix.lower()

            if ext not in ALLOWED_AUDIO:
                raise ValueError(
                    f"Unsupported audio format: {audio.filename}"
                )

            safe_audio = secure_filename(audio.filename)

            stem = Path(safe_audio).stem
            suffix = Path(safe_audio).suffix

            candidate = safe_audio
            counter = 1

            while (MUSIC_DIR / candidate).exists():
                candidate = f"{stem}-{counter}{suffix}"
                counter += 1

            audio_path = MUSIC_DIR / candidate
            audio.save(audio_path)
            saved.append(audio_path)

            title = Path(audio.filename).stem
            title = title.replace("_", " ")
            title = title.replace("-", " ")
            title = " ".join(title.split())

            connection.execute(
                """
                INSERT INTO songs(
                    title,
                    artist,
                    genre,
                    album,
                    cover,
                    audio,
                    album_id,
                    track_number
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    title,
                    album["artist"],
                    album["genre"],
                    album["title"],
                    album["cover"],
                    candidate,
                    album_id,
                    next_track
                )
            )

            next_track += 1

        connection.commit()
        connection.close()

    except Exception as error:

        connection.rollback()
        connection.close()

        for file in saved:
            try:
                if file.exists():
                    file.unlink()
            except Exception:
                pass

        return f"Tracks could not be added: {error}", 500

    return redirect(
        url_for(
            "edit_album_manager",
            album_id=album_id
        )
    )


