def ensure_album_schema():
    connection = db()

    connection.execute("""
        CREATE TABLE IF NOT EXISTS albums (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            artist TEXT NOT NULL,
            genre TEXT DEFAULT 'Other',
            cover TEXT DEFAULT '',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)

    columns = {
        row["name"]
        for row in connection.execute(
            "PRAGMA table_info(songs)"
        ).fetchall()
    }

    if "album_id" not in columns:
        connection.execute(
            "ALTER TABLE songs ADD COLUMN album_id INTEGER"
        )

    if "track_number" not in columns:
        connection.execute(
            "ALTER TABLE songs ADD COLUMN track_number INTEGER DEFAULT 0"
        )

    # Give old songs with album text a proper album record.
    old_albums = connection.execute("""
        SELECT DISTINCT album
        FROM songs
        WHERE album IS NOT NULL
          AND TRIM(album) != ''
          AND (album_id IS NULL OR album_id = 0)
    """).fetchall()

    for row in old_albums:
        album_name = row["album"].strip()

        existing = connection.execute(
            """
            SELECT id
            FROM albums
            WHERE LOWER(title) = LOWER(?)
            LIMIT 1
            """,
            (album_name,)
        ).fetchone()

        if existing:
            album_id = existing["id"]
        else:
            song = connection.execute(
                """
                SELECT artist, genre, cover
                FROM songs
                WHERE album = ?
                ORDER BY id
                LIMIT 1
                """,
                (album_name,)
            ).fetchone()

            album_id = connection.execute(
                """
                INSERT INTO albums(title, artist, genre, cover)
                VALUES (?, ?, ?, ?)
                """,
                (
                    album_name,
                    song["artist"] if song else "",
                    song["genre"] if song else "Other",
                    song["cover"] if song else "",
                )
            ).lastrowid

        songs = connection.execute(
            """
            SELECT id
            FROM songs
            WHERE album = ?
              AND (album_id IS NULL OR album_id = 0)
            ORDER BY id
            """,
            (album_name,)
        ).fetchall()

        for position, song in enumerate(songs, start=1):
            connection.execute(
                """
                UPDATE songs
                SET album_id = ?, track_number = ?
                WHERE id = ?
                """,
                (album_id, position, song["id"])
            )

    connection.commit()
    connection.close()


