@app.route("/admin/albums/create", methods=["POST"])
@admin_required
def create_album():
    ensure_album_schema()

    title = request.form.get("album", "").strip()
    artist = request.form.get("artist", "").strip()
    genre = request.form.get("genre", "Other").strip()
    cover_file = request.files.get("cover")

    audio_files = [
        file
        for file in request.files.getlist("audio")
        if file and file.filename
    ]

    if not title:
        return "Album name is required.", 400

    if not artist:
        return "Artist name is required.", 400

    if not audio_files:
        return "Select at least one track.", 400

    for audio in audio_files:
        if Path(audio.filename).suffix.lower() not in ALLOWED_AUDIO:
            return f"Unsupported audio format: {audio.filename}", 400

    if not cover_file or not cover_file.filename:
        return "Album artwork is required.", 400

    cover_ext = Path(cover_file.filename).suffix.lower()

    if cover_ext not in ALLOWED_IMAGE:
        return "Unsupported artwork format.", 400

    images_dir = BASE_DIR / "static" / "images" / "albums"
    images_dir.mkdir(parents=True, exist_ok=True)
    MUSIC_DIR.mkdir(parents=True, exist_ok=True)

    connection = None
    saved_audio = []
    saved_cover = None

    try:
        # Artwork
        safe_cover = secure_filename(cover_file.filename)

        if not safe_cover:
            raise ValueError("Invalid artwork filename.")

        stem = Path(safe_cover).stem
        suffix = Path(safe_cover).suffix
        candidate = safe_cover
        counter = 1

        while (images_dir / candidate).exists():
            candidate = f"{stem}-{counter}{suffix}"
            counter += 1

        saved_cover = images_dir / candidate
        cover_file.save(saved_cover)

        cover_name = f"albums/{candidate}"

        connection = db()

        album_id = connection.execute(
            """
            INSERT INTO albums(title, artist, genre, cover)
            VALUES (?, ?, ?, ?)
            """,
            (title, artist, genre, cover_name)
        ).lastrowid

        # Every selected file goes into THIS album.
        for position, audio in enumerate(audio_files, start=1):

            safe_audio = secure_filename(audio.filename)

            if not safe_audio:
                raise ValueError(
                    f"Invalid filename: {audio.filename}"
                )

            stem = Path(safe_audio).stem
            suffix = Path(safe_audio).suffix

            candidate = safe_audio
            counter = 1

            while (MUSIC_DIR / candidate).exists():
                candidate = f"{stem}-{counter}{suffix}"
                counter += 1

            audio_path = MUSIC_DIR / candidate
            audio.save(audio_path)
            saved_audio.append(audio_path)

            song_title = Path(audio.filename).stem
            song_title = song_title.replace("_", " ")
            song_title = song_title.replace("-", " ")
            song_title = " ".join(song_title.split())

            if not song_title:
                song_title = f"Track {position}"

            connection.execute(
                """
                INSERT INTO songs(
                    title,
                    artist,
                    genre,
                    album,
                    cover,
                    audio,
                    album_id,
                    track_number
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    song_title,
                    artist,
                    genre,
                    title,
                    cover_name,
                    candidate,
                    album_id,
                    position
                )
            )

        connection.commit()
        connection.close()
        connection = None

    except Exception as error:

        print("CREATE ALBUM ERROR:", error)

        if connection:
            try:
                connection.rollback()
                connection.close()
            except Exception:
                pass

        for audio_path in saved_audio:
            try:
                if audio_path.exists():
                    audio_path.unlink()
            except Exception:
                pass

        if saved_cover:
            try:
                if saved_cover.exists():
                    saved_cover.unlink()
            except Exception:
                pass

        return f"Album creation failed: {error}", 500

    return redirect(url_for("edit_album_manager", album_id=album_id))


