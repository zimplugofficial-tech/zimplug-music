    ).fetchall()

    for position, track in enumerate(tracks, start=1):
        connection.execute(
            """
            UPDATE songs
            SET track_number = ?
            WHERE id = ?
            """,
            (
                position,
                track["id"]
            )
        )

    connection.commit()
    connection.close()

    try:
        if audio_path.exists():
            audio_path.unlink()
    except Exception:
        pass

