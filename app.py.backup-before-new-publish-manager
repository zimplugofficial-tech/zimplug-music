@app.route("/admin/albums/<int:album_id>/save", methods=["POST"])
@admin_required
def save_album_manager(album_id):
    ensure_album_schema()

    title = request.form.get("album", "").strip()
    artist = request.form.get("artist", "").strip()
    genre = request.form.get("genre", "Other").strip()
    cover_file = request.files.get("cover")

    if not title or not artist:
        return "Album name and artist are required.", 400

    connection = db()

    album = connection.execute(
        "SELECT * FROM albums WHERE id = ?",
        (album_id,)
    ).fetchone()

    if not album:
        connection.close()
        return "Album not found.", 404

    cover_name = album["cover"]

    try:

        if cover_file and cover_file.filename:

            ext = Path(cover_file.filename).suffix.lower()

            if ext not in ALLOWED_IMAGE:
                connection.close()
                return "Unsupported artwork format.", 400

            images_dir = BASE_DIR / "static" / "images" / "albums"
            images_dir.mkdir(parents=True, exist_ok=True)

            safe_cover = secure_filename(cover_file.filename)

            stem = Path(safe_cover).stem
            suffix = Path(safe_cover).suffix
            candidate = safe_cover
            counter = 1

            while (images_dir / candidate).exists():
                candidate = f"{stem}-{counter}{suffix}"
                counter += 1

            cover_file.save(images_dir / candidate)
            cover_name = f"albums/{candidate}"

        connection.execute(
            """
            UPDATE albums
            SET title = ?,
                artist = ?,
                genre = ?,
                cover = ?
            WHERE id = ?
            """,
            (
                title,
                artist,
