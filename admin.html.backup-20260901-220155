<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ZimPlug Admin</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/style.css') }}">
</head>

<body class="admin-body">

<header class="admin-header">

    <a href="/" class="admin-brand">
        <img src="{{ url_for('static', filename='images/logo.png') }}"
             alt="ZimPlug Music">
    </a>

    <div class="admin-header-center">
        <span>ADMIN DASHBOARD</span>
    </div>

    <div class="admin-header-actions">
        <a href="/" class="admin-view-site">VIEW SITE</a>
        <a href="/admin/logout" class="admin-logout">LOG OUT</a>
    </div>

</header>


<main class="admin-dashboard">

    <section class="admin-welcome">

        <div>
            <span class="eyebrow">ZIMPLUG MUSIC</span>

            <h1>Control your<br><span>music platform.</span></h1>

            <p>
                Manage music, publish news and keep your ZimPlug
                library up to date.
            </p>
        </div>

        <div class="admin-status">
            <span class="status-dot"></span>
            SYSTEM ONLINE
        </div>

    </section>


    <!-- STATS -->

    <section class="admin-stats">

        <div class="admin-stat">
            <span class="stat-icon">♪</span>
            <div>
                <small>TOTAL MUSIC</small>
                <strong>{{ songs|length }}</strong>
            </div>
        </div>

        <div class="admin-stat">
            <span class="stat-icon">▶</span>
            <div>
                <small>TOTAL PLAYS</small>
                <strong>
                    {{ songs|sum(attribute='plays') }}
                </strong>
            </div>
        </div>

        <div class="admin-stat">
            <span class="stat-icon">↓</span>
            <div>
                <small>DOWNLOADS</small>
                <strong>
                    {{ songs|sum(attribute='downloads') }}
                </strong>
            </div>
        </div>

        <div class="admin-stat">
            <span class="stat-icon">★</span>
            <div>
                <small>PLATFORM</small>
                <strong>LIVE</strong>
            </div>
        </div>

    </section>


    <!-- MAIN GRID -->

    <section class="admin-main-grid">


        <!-- UPLOAD -->

        <div class="admin-panel upload-panel">

            <div class="panel-heading">

                <div>
                    <span class="eyebrow">MUSIC</span>
                    <h2>Upload new song</h2>
                </div>

                <span class="panel-number">01</span>

            </div>

            <p class="panel-description">
                Add a song to the ZimPlug Music library.
            </p>


            <form method="POST"
                  action="/admin/upload"
                  enctype="multipart/form-data"
                  class="admin-upload-form">


                <div class="admin-form-grid">

                    <div class="admin-field">
                        <label>Song title</label>
                        <input
                            name="title"
                            placeholder="Enter song title"
                            required
                        >
                    </div>

                    <div class="admin-field">
                        <label>Artist</label>
                        <input
                            name="artist"
                            placeholder="Artist name"
                            required
                        >
                    </div>

                    <div class="admin-field">
                        <label>Genre</label>

                        <select name="genre">

                            <option>AfroSounds</option>
                            <option>Afrobeats</option>
                            <option>Hip Hop</option>
                            <option>Zimdancehall</option>
                            <option>R&B</option>
                            <option>Amapiano</option>
                            <option>Gospel</option>
                            <option>Dance</option>
                            <option>Pop</option>
                            <option>Soul</option>
                            <option>Reggae</option>
                            <option>Other</option>

                        </select>

                    </div>

                    <div class="admin-field">
                        <label>Album</label>

                        <input
                            name="album"
                            placeholder="Album name (optional)"
                        >

                    </div>

                </div>


                <div class="admin-upload-files">

                    <label class="file-upload-box">

                        <input
                            type="file"
                            name="audio"
                            accept=".mp3,.wav,.m4a,.aac,.ogg"
                            required
                        >

                        <span class="file-icon">♫</span>

                        <strong>Choose audio file</strong>

                        <small>
                            MP3, WAV, M4A, AAC or OGG
                        </small>

                    </label>


                    <label class="file-upload-box">

                        <input
                            type="file"
                            name="cover"
                            accept=".jpg,.jpeg,.png,.webp"
                        >

                        <span class="file-icon">▧</span>

                        <strong>Choose cover artwork</strong>

                        <small>
                            JPG, PNG or WEBP
                        </small>

                    </label>

                </div>


                <button type="submit"
                        class="admin-publish-button">

                    <span>↑</span>
                    PUBLISH SONG

                </button>

            </form>

        </div>


        <!-- ALBUM UPLOAD -->

        <div class="admin-panel upload-panel album-upload-panel">

            <div class="panel-heading">

                <div>

                    <span class="eyebrow">MUSIC</span>

                    <h2>Upload album</h2>

                </div>

                <span class="panel-number">02</span>

            </div>

            <p class="panel-description">

                Upload a complete album and publish all of its tracks at once.

            </p>


            <form method="POST"

                  action="/admin/upload-album"

                  enctype="multipart/form-data"

                  class="admin-upload-form">


                <div class="admin-form-grid">

                    <div class="admin-field">

                        <label>Album name</label>

                        <input

                            name="album"

                            placeholder="Enter album name"

                            required

                        >

                    </div>


                    <div class="admin-field">

                        <label>Artist</label>

                        <input

                            name="artist"

                            placeholder="Artist name"

                            required

                        >

                    </div>


                    <div class="admin-field">

                        <label>Genre</label>

                        <select name="genre">

                            <option>AfroSounds</option>

                            <option>Afrobeats</option>

                            <option>Hip Hop</option>

                            <option>Zimdancehall</option>

                            <option>R&B</option>

                            <option>Amapiano</option>

                            <option>Gospel</option>

                            <option>Dance</option>

                            <option>Pop</option>

                            <option>Soul</option>

                            <option>Reggae</option>

                            <option>Other</option>

                        </select>

                    </div>

                </div>


                <div class="admin-upload-files">

                    <label class="file-upload-box">

                        <input

                            type="file"

                            name="audio"

                            accept=".mp3,.wav,.m4a,.aac,.ogg"

                            multiple

                            required

                        >

                        <span class="file-icon">♫</span>

                        <strong>Choose album tracks</strong>

                        <small>

                            Select multiple MP3, WAV, M4A, AAC or OGG files

                        </small>

                    </label>


                    <label class="file-upload-box">

                        <input

                            type="file"

                            name="cover"

                            accept=".jpg,.jpeg,.png,.webp"

                            required

                        >

                        <span class="file-icon">▧</span>

                        <strong>Choose album artwork</strong>

                        <small>

                            JPG, PNG or WEBP

                        </small>

                    </label>

                </div>


                <button type="submit"

                        class="admin-publish-button">

                    <span>↑</span>

                    PUBLISH ALBUM

                </button>

            </form>

        </div>


        <!-- NEWS -->

        <div class="admin-panel news-panel">

            <div class="panel-heading">

                <div>
                    <span class="eyebrow">NEWS</span>
                    <h2>Publish update</h2>
                </div>

                <span class="panel-number">03</span>

            </div>

            <p class="panel-description">
                Share announcements, artist news and platform updates.
            </p>


            <form method="POST"
                  action="/admin/news"
                  class="admin-news-form">

                <div class="admin-field">

                    <label>Headline</label>

                    <input
                        name="title"
                        placeholder="News headline"
                        required
                    >

                </div>


                <div class="admin-field">

                    <label>Story</label>

                    <textarea
                        name="body"
                        rows="8"
                        placeholder="Write your story..."
                        required
                    ></textarea>

                </div>


                <button type="submit"
                        class="admin-publish-button">

                    PUBLISH NEWS

                </button>

            </form>

        </div>

    </section>


    <!-- MUSIC LIBRARY -->

    <section class="admin-panel library-panel">

        <div class="panel-heading">

            <div>
                <span class="eyebrow">LIBRARY</span>
                <h2>Uploaded music</h2>
            </div>

            <span class="library-total">
                {{ songs|length }} SONGS
            </span>

        </div>


        {% if songs %}

        <div class="admin-library">

            {% for song in songs %}

            <div class="admin-song-row">

                <div class="admin-song-number">
                    {{ "%02d"|format(loop.index) }}
                </div>


                <div class="admin-song-cover">

                    {% if song.cover %}

                    <img
                        src="{{ url_for('static', filename='images/' + song.cover) }}"
                        alt="{{ song.title }}"
                    >

                    {% else %}

                    <span>♪</span>

                    {% endif %}

                </div>


                <div class="admin-song-info">

                    <strong>{{ song.title }}</strong>

                    <span>
                        {{ song.artist }}

                        {% if song.album %}
                            · {{ song.album }}
                        {% endif %}
                    </span>

                </div>


                <div class="admin-song-genre">
                    {{ song.genre }}
                </div>


                <div class="admin-song-metrics">

                    <span>
                        <b>{{ song.plays }}</b>
                        plays
                    </span>

                    <span>
                        <b>{{ song.downloads }}</b>
                        downloads
                    </span>

                </div>


                <a href="/download/{{ song.id }}"
                   class="admin-download"
                   title="Download">

                    ↓

                </a>


                <form method="POST"
                      action="/admin/delete-song/{{ song.id }}"
                      onsubmit="return confirm('Delete {{ song.title|e }}?');">

                    <button
                        type="submit"
                        class="admin-delete"
                        title="Delete song">

                        ×

                    </button>

                </form>

            </div>

            {% endfor %}

        </div>

        {% else %}

        <div class="admin-empty">

            <span>♪</span>

            <h3>Your music library is empty</h3>

            <p>
                Upload your first song using the upload panel above.
            </p>

        </div>

        {% endif %}

    </section>


    <!-- QUICK LINKS -->

    <section class="admin-quick-links">

        <a href="/music">
            <span>♪</span>
            <div>
                <strong>Music Library</strong>
                <small>View public music</small>
            </div>
            <b>→</b>
        </a>

        <a href="/news">
            <span>▤</span>
            <div>
                <strong>News</strong>
                <small>View published stories</small>
            </div>
            <b>→</b>
        </a>

        <a href="/help">
            <span>?</span>
            <div>
                <strong>Help Centre</strong>
                <small>Platform support</small>
            </div>
            <b>→</b>
        </a>

    </section>

</main>

</body>
</html>
