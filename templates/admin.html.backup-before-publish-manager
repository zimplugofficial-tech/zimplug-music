{% extends "base.html" %}

{% block title %}Admin · ZimPlug Music{% endblock %}

{% block content %}

<style>
    .admin-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 45px 24px 70px;
    }

    .admin-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .admin-kicker {
        margin: 0 0 7px;
        color: #d4af37;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .admin-header h1 {
        margin: 0;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -.02em;
    }

    .admin-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 42px;
    }

    .admin-action {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 92px;
        padding: 20px 22px;
        background: #101010;
        border: 1px solid rgba(255,255,255,.08);
        color: #fff;
        text-decoration: none;
        transition: border-color .2s ease, transform .2s ease;
    }

    .admin-action:hover {
        border-color: #d4af37;
        transform: translateY(-2px);
    }

    .admin-action-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        margin-right: 16px;
        border: 1px solid rgba(212,175,55,.35);
        color: #d4af37;
        font-size: 22px;
    }

    .admin-action-copy {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .admin-action-copy strong {
        font-size: 13px;
        letter-spacing: .08em;
    }

    .admin-action-copy span {
        color: #858585;
        font-size: 12px;
    }

    .admin-action-arrow {
        margin-left: auto;
        color: #d4af37;
        font-size: 21px;
    }

    .library-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 15px;
        margin-bottom: 16px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .library-header h2 {
        margin: 0;
        color: #fff;
        font-size: 18px;
    }

    .library-count {
        color: #858585;
        font-size: 12px;
    }

    .music-library {
        display: grid;
        gap: 1px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.07);
    }

    .song-row {
        display: flex;
        align-items: center;
        gap: 15px;
        min-height: 78px;
        padding: 12px 16px;
        background: #0b0b0b;
    }

    .song-cover {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        overflow: hidden;
        background: #151515;
        border: 1px solid rgba(255,255,255,.06);
    }

    .song-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .song-cover-empty {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        color: #555;
        font-size: 19px;
    }

    .song-info {
        min-width: 0;
        flex: 1;
    }

    .song-title {
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .song-artist {
        margin-top: 5px;
        color: #858585;
        font-size: 12px;
    }

    .song-meta {
        color: #858585;
        font-size: 11px;
        text-align: right;
    }

    .song-meta strong {
        color: #d4af37;
        font-weight: 500;
    }

    .empty-library {
        padding: 55px 20px;
        text-align: center;
        background: #0b0b0b;
        border: 1px solid rgba(255,255,255,.07);
        color: #858585;
        font-size: 13px;
    }

    @media (max-width: 700px) {
        .admin-page {
            padding: 30px 16px 50px;
        }

        .admin-header {
            align-items: flex-start;
        }

        .admin-header h1 {
            font-size: 25px;
        }

        .admin-actions {
            grid-template-columns: 1fr;
        }

        .song-meta {
            display: none;
        }
    }
</style>

<div class="admin-page">

    <header class="admin-header">
        <div>
            <p class="admin-kicker">ZimPlug Music</p>
            <h1>Administration</h1>
        </div>
    
        <a href="{{ url_for('admin_logout') }}" class="admin-logout">
            LOG OUT
        </a>

</header>

    <section class="admin-actions">

        <a href="{{ url_for('admin_upload') }}" class="admin-action">
            <span class="admin-action-icon">♪</span>
            <span class="admin-action-copy">
                <strong>UPLOAD SINGLE SONG</strong>
                <span>Add one song to the music library</span>
            </span>
            <span class="admin-action-arrow">→</span>
        </a>

        <a href="{{ url_for('admin_albums') }}" class="admin-action">
            <span class="admin-action-icon">♫</span>
            <span class="admin-action-copy">
                <strong>MANAGE ALBUMS</strong>
                <span>Create and manage album tracks</span>
            </span>
            <span class="admin-action-arrow">→</span>
        </a>

    </section>

    <section>
        <div class="library-header">
            <h2>Music Library</h2>
            <span class="library-count">{{ songs|length }} songs</span>
        </div>

        {% if songs %}

        <div class="music-library">

            {% for song in songs %}

            <div class="song-row">

                <div class="song-cover">
                    {% if song.cover %}
                        <img src="{{ url_for('static', filename='images/' + song.cover) }}" alt="">
                    {% else %}
                        <div class="song-cover-empty">♪</div>
                    {% endif %}
                </div>

                <div class="song-info">
                    <div class="song-title">{{ song.title }}</div>
                    <div class="song-artist">
                        {{ song.artist }}
                        {% if song.album %}
                            · {{ song.album }}
                        {% endif %}
                    </div>
                </div>

                <div class="song-meta">
                    <strong>{{ song.genre }}</strong>
                </div>

            </div>

            {% endfor %}

        </div>

        {% else %}

        <div class="empty-library">
            No songs have been uploaded yet.
        </div>

        {% endif %}

    </section>

</div>

{% endblock %}
