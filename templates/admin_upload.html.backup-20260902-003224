{% extends "base.html" %}

{% block content %}

<section class="admin-upload-page">

    <div class="admin-upload-header">
        <a href="{{ url_for('admin') }}" class="admin-back">← Back to Admin</a>

        <div>
            <span class="admin-eyebrow">ZIMPLUG MUSIC</span>
            <h1>Upload Single Song</h1>
            <p>Add a standalone song to the ZimPlug Music library.</p>
        </div>
    </div>

    <form
        action="{{ url_for('admin_upload') }}"
        method="POST"
        enctype="multipart/form-data"
        class="admin-upload-card"
    >

        <div class="upload-section">
            <div class="upload-section-title">
                <span>01</span>
                <div>
                    <h2>Song Information</h2>
                    <p>Basic information about the track.</p>
                </div>
            </div>

            <div class="upload-grid">

                <div class="upload-field upload-full">
                    <label for="title">Song Title *</label>
                    <input
                        id="title"
                        type="text"
                        name="title"
                        placeholder="Enter song title"
                        required
                    >
                </div>

                <div class="upload-field">
                    <label for="artist">Artist Name *</label>
                    <input
                        id="artist"
                        type="text"
                        name="artist"
                        placeholder="Enter artist name"
                        required
                    >
                </div>

                <div class="upload-field">
                    <label for="genre">Genre</label>
                    <select id="genre" name="genre">
                        <option value="Other">Other</option>
                        <option value="Afrobeat">Afrobeat</option>
                        <option value="Amapiano">Amapiano</option>
                        <option value="Hip Hop">Hip Hop</option>
                        <option value="Dancehall">Dancehall</option>
                        <option value="Gospel">Gospel</option>
                        <option value="Zimdancehall">Zimdancehall</option>
                        <option value="R&B">R&B</option>
                        <option value="Afropop">Afropop</option>
                        <option value="House">House</option>
                        <option value="Pop">Pop</option>
                        <option value="Reggae">Reggae</option>
                    </select>
                </div>

                <div class="upload-field upload-full">
                    <label for="album">Album <span>(Optional)</span></label>
                    <input
                        id="album"
                        type="text"
                        name="album"
                        placeholder="Album name, or leave blank for a single"
                    >
                </div>

            </div>
        </div>


        <div class="upload-section">
            <div class="upload-section-title">
                <span>02</span>
                <div>
                    <h2>Audio File</h2>
                    <p>Upload the song visitors will listen to and download.</p>
                </div>
            </div>

            <label class="file-drop">
                <input
                    type="file"
                    name="audio"
                    accept="audio/*,.mp3,.wav,.m4a,.aac,.ogg,.flac"
                    required
                >
                <strong>♪ Choose Audio File</strong>
                <small>MP3 and other supported audio formats</small>
            </label>
        </div>


        <div class="upload-section">
            <div class="upload-section-title">
                <span>03</span>
                <div>
                    <h2>Song Artwork</h2>
                    <p>Add artwork that will appear across ZimPlug Music.</p>
                </div>
            </div>

            <label class="file-drop artwork-drop">
                <input
                    type="file"
                    name="cover"
                    accept="image/*,.jpg,.jpeg,.png,.webp"
                >
                <strong>▣ Choose Cover Image</strong>
                <small>JPG, PNG or WebP recommended</small>
            </label>
        </div>


        <div class="upload-actions">
            <a href="{{ url_for('admin') }}" class="cancel-upload">
                Cancel
            </a>

            <button type="submit" class="upload-song-button">
                Upload Song
                <span>→</span>
            </button>
        </div>

    </form>

</section>

<style>
.admin-upload-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 40px 20px 80px;
}

.admin-upload-header {
    margin-bottom: 30px;
}

.admin-back {
    display: inline-block;
    margin-bottom: 28px;
    color: #858585;
    text-decoration: none;
    font-size: 13px;
}

.admin-back:hover {
    color: #d4af37;
}

.admin-eyebrow {
    color: #d4af37;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.admin-upload-header h1 {
    margin: 8px 0 6px;
    color: #fff;
    font-size: 32px;
}

.admin-upload-header p {
    margin: 0;
    color: #858585;
}

.admin-upload-card {
    background: #101010;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 16px;
    overflow: hidden;
}

.upload-section {
    padding: 30px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.upload-section-title {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 25px;
}

.upload-section-title > span {
    color: #d4af37;
    font-size: 12px;
    font-weight: 800;
    padding-top: 5px;
}

.upload-section-title h2 {
    margin: 0 0 5px;
    color: #fff;
    font-size: 18px;
}

.upload-section-title p {
    margin: 0;
    color: #858585;
    font-size: 13px;
}

.upload-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.upload-full {
    grid-column: 1 / -1;
}

.upload-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.upload-field label {
    color: #fff;
    font-size: 13px;
    font-weight: 600;
}

.upload-field label span {
    color: #858585;
    font-weight: 400;
}

.upload-field input,
.upload-field select {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    background: #0b0b0b;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 9px;
    color: #fff;
    outline: none;
    font: inherit;
}

.upload-field input:focus,
.upload-field select:focus {
    border-color: #d4af37;
}

.file-drop {
    min-height: 150px;
    box-sizing: border-box;
    border: 1px dashed rgba(212,175,55,.4);
    border-radius: 12px;
    background: #0b0b0b;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: .2s ease;
}

.file-drop:hover {
    border-color: #d4af37;
    background: #111;
}

.file-drop input {
    display: none;
}

.file-drop strong {
    color: #d4af37;
    font-size: 15px;
    margin-bottom: 7px;
}

.file-drop small {
    color: #858585;
    font-size: 12px;
}

.upload-actions {
    padding: 22px 30px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 15px;
    background: #0b0b0b;
}

.cancel-upload {
    color: #858585;
    text-decoration: none;
    font-size: 13px;
}

.cancel-upload:hover {
    color: #fff;
}

.upload-song-button {
    border: 0;
    background: #d4af37;
    color: #050505;
    padding: 13px 22px;
    border-radius: 8px;
    font-weight: 800;
    cursor: pointer;
    font-size: 13px;
}

.upload-song-button:hover {
    background: #f1ce58;
}

.upload-song-button span {
    margin-left: 8px;
}

@media (max-width: 700px) {
    .admin-upload-page {
        padding: 25px 15px 60px;
    }

    .upload-section {
        padding: 22px;
    }

    .upload-grid {
        grid-template-columns: 1fr;
    }

    .upload-full {
        grid-column: auto;
    }

    .upload-actions {
        padding: 20px 22px;
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .upload-song-button {
        width: 100%;
    }

    .cancel-upload {
        text-align: center;
    }
}
</style>

{% endblock %}
