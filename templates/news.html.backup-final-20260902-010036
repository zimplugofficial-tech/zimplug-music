{% extends "base.html" %}

{% block content %}

<section class="news-page">

    <div class="news-page-header">
        <div class="news-page-label">ZIMPLUG NEWS</div>
        <h1>Latest News</h1>
        <p>Music, artists, releases and stories from Zimbabwe and beyond.</p>
    </div>

    {% if articles %}

    <div class="news-grid">

        {% for article in articles %}

        <a href="{{ url_for('news_article', news_id=article['id']) }}"
           class="news-card">

            {% if article['image'] %}
            <div class="news-card-image">
                <img
                    src="{{ url_for('static', filename='images/news/' ~ article['image']) }}"
                    alt="{{ article['title'] }}"
                >
            </div>
            {% endif %}

            <div class="news-card-content">

                <div class="news-card-label">
                    ZIMPLUG NEWS
                </div>

                <h2>{{ article['title'] }}</h2>

                <div class="news-card-date">
                    {{ article['created_at'] }}
                </div>

                <span class="news-read">
                    READ ARTICLE →
                </span>

            </div>

        </a>

        {% endfor %}

    </div>

    {% else %}

    <div class="news-empty">
        <h2>No news yet</h2>
        <p>Check back soon for the latest stories.</p>
    </div>

    {% endif %}

</section>

{% endblock %}
