<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ZimPlug Admin</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='css/style.css') }}">
</head>

<body class="admin-body">

<header class="admin-header">

    <a href="/" class="admin-brand">
        <img src="{{ url_for('static', filename='images/logo.png') }}"
             alt="ZimPlug Music">
    </a>

    <div class="admin-header-center">
        <span>ADMIN DASHBOARD</span>
    </div>

    <div class="admin-header-actions">
        <a href="/" class="admin-view-site">VIEW SITE</a>
        <a href="/admin/logout" class="admin-logout">LOG OUT</a>
    </div>

</header>


<main class="admin-dashboard">
        <a href="{{ url_for('admin_albums') }}"
           class="admin-publish-button"
           style="display:inline-flex;text-decoration:none;margin-bottom:25px;">
            🎵 ALBUM MANAGER
        </a>


    


    <!-- STATS -->

    


    <!-- MUSIC LIBRARY -->

    <section class="admin-panel library-panel">

        <div class="panel-heading">

            <div>
                <span class="eyebrow">LIBRARY</span>
                <h2>Uploaded music</h2>
            </div>

            <span class="library-total">
                {{ songs|length }} SONGS
            </span>

        </div>


        {% if songs %}

        <div class="admin-library">

            {% for song in songs %}

            <div class="admin-song-row">

                <div class="admin-song-number">
                    {{ "%02d"|format(loop.index) }}
                </div>


                <div class="admin-song-cover">

                    {% if song.cover %}

                    <img
                        src="{{ url_for('static', filename='images/' + song.cover) }}"
                        alt="{{ song.title }}"
                    >

                    {% else %}

                    <span>♪</span>

                    {% endif %}

                </div>


                <div class="admin-song-info">

                    <strong>{{ song.title }}</strong>

                    <span>
                        {{ song.artist }}

                        {% if song.album %}
                            · {{ song.album }}
                        {% endif %}
                    </span>

                </div>


                <div class="admin-song-genre">
                    {{ song.genre }}
                </div>


                <div class="admin-song-metrics">

                    <span>
                        <b>{{ song.plays }}</b>
                        plays
                    </span>

                    <span>
                        <b>{{ song.downloads }}</b>
                        downloads
                    </span>

                </div>


                <a href="/download/{{ song.id }}"
                   class="admin-download"
                   title="Download">

                    ↓

                </a>


                <form method="POST"
                      action="/admin/delete-song/{{ song.id }}"
                      onsubmit="return confirm('Delete {{ song.title|e }}?');">

                    <button
                        type="submit"
                        class="admin-delete"
                        title="Delete song">

                        ×

                    </button>

                </form>

            </div>

            {% endfor %}

        </div>

        {% else %}

        <div class="admin-empty">

            <span>♪</span>

            <h3>Your music library is empty</h3>

            <p>
                Upload your first song using the upload panel above.
            </p>

        </div>

        {% endif %}

    </section>


    <!-- QUICK LINKS -->

    <section class="admin-quick-links">

        <a href="/music">
            <span>♪</span>
            <div>
                <strong>Music Library</strong>
                <small>View public music</small>
            </div>
            <b>→</b>
        </a>

        


<a href="/news">
            <span>▤</span>
            <div>
                <strong>News</strong>
                <small>View published stories</small>
            </div>
            <b>→</b>
        </a>

        <a href="/help">
            <span>?</span>
            <div>
                <strong>Help Centre</strong>
                <small>Platform support</small>
            </div>
            <b>→</b>
        </a>

    </section>

</main>

</body>
</html>
