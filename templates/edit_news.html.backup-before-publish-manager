{% extends "base.html" %}

{% block content %}

<main class="admin-page">

    <section class="admin-hero">

        <span class="eyebrow">ZIMPLUG ADMIN</span>

        <h1>Edit <span>News.</span></h1>

        <p>Correct the article, update the picture or make changes before publishing.</p>

    </section>

    {% if error %}
    <div class="admin-error">
        {{ error }}
    </div>
    {% endif %}

    <section class="admin-panel">

        <div class="panel-heading">

            <div>
                <span class="eyebrow">MANAGE</span>
                <h2>Edit Article</h2>
            </div>

        </div>

        <form method="POST"
              enctype="multipart/form-data"
              class="submit-form">

            <label>

                <span>News title</span>

                <input
                    type="text"
                    name="title"
                    value="{{ article.title }}"
                    required
                >

            </label>


            {% if article.image %}

            <label>

                <span>Current picture</span>

                <div style="margin-top:12px;">

                    <img
                        src="{{ url_for('static', filename='images/news/' + article.image) }}"
                        alt="{{ article.title }}"
                        style="width:220px;max-width:100%;border-radius:10px;display:block;"
                    >

                </div>

            </label>

            {% endif %}


            <label>

                <span>Replace picture</span>

                <input
                    type="file"
                    name="image"
                    accept="image/jpeg,image/png,image/webp"
                >

                <small>
                    Leave empty to keep the current picture.
                </small>

            </label>


            <label>

                <span>Article</span>

                <textarea
                    name="body"
                    rows="18"
                    required
                >{{ article.body }}</textarea>

            </label>


            <div style="display:flex;gap:12px;flex-wrap:wrap;">

                <button type="submit" class="gold-button">
                    SAVE CHANGES →
                </button>

                <a
                    href="{{ url_for('admin_news') }}"
                    class="gold-button"
                    style="text-decoration:none;"
                >
                    CANCEL
                </a>

            </div>

        </form>

    </section>

</main>

{% endblock %}
