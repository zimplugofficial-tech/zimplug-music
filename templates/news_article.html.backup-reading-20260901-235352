{% extends "base.html" %}

{% block content %}

<section class="news-article-page">

    <div class="news-article-container">

        <a href="/news" class="news-back">
            ← BACK TO NEWS
        </a>

        {% if article["image"] %}
        <div class="news-article-image">
            <img
                src="{{ url_for('static', filename='images/news/' ~ article['image']) }}"
                alt="{{ article['title'] }}"
            >
        </div>
        {% endif %}

        <div class="news-article-header">

            <div class="news-label">
                ZIMPLUG NEWS
            </div>

            <h1>{{ article["title"] }}</h1>

            <div class="news-date">
                {{ article["created_at"] }}
            </div>

        </div>

        <div class="news-article-body">
            {{ article["body"] }}
        </div>

    </div>

</section>

{% endblock %}
