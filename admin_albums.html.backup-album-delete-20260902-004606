{% extends "base.html" %}

{% block content %}

<div class="admin-page" style="max-width:1200px;margin:40px auto;padding:0 20px;">

    <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:35px;">
        <div>
            <div style="color:#c9a24a;font-size:12px;font-weight:700;letter-spacing:2px;">
                ZIMPLUG MUSIC
            </div>

            <h1 style="margin:8px 0;">
                Album Manager
            </h1>

            <p style="color:#929292;margin:0;">
                Create, edit and arrange your albums and tracks.
            </p>
        </div>

        <a href="{{ url_for('admin') }}"
           class="admin-publish-button"
           style="text-decoration:none;">
            ← ADMIN
        </a>
    </div>


    <!-- CREATE ALBUM -->

    <div style="background:#111;border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:25px;margin-bottom:40px;">

        <h2 style="margin-top:0;">
            + Create New Album
        </h2>

        <p style="color:#929292;">
            Select as many tracks as you want. They will all be grouped into one album.
        </p>

        <form method="POST"
              action="{{ url_for('create_album') }}"
              enctype="multipart/form-data">

            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:15px;">

                <div class="admin-field">
                    <label>Album Name</label>
                    <input name="album"
                           placeholder="Album name"
                           required>
                </div>

                <div class="admin-field">
                    <label>Artist</label>
                    <input name="artist"
                           placeholder="Artist"
                           required>
                </div>

                <div class="admin-field">
                    <label>Genre</label>
                    <select name="genre">
                        <option>AfroSounds</option>
                        <option>Afrobeats</option>
                        <option>Hip Hop</option>
                        <option>Zimdancehall</option>
                        <option>R&B</option>
                        <option>Amapiano</option>
                        <option>Gospel</option>
                        <option>Dance</option>
                        <option>Pop</option>
                        <option>Soul</option>
                        <option>Reggae</option>
                        <option>Other</option>
                    </select>
                </div>

            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px;">

                <label style="border:1px dashed rgba(255,255,255,.15);padding:25px;border-radius:12px;cursor:pointer;">
                    <strong>♫ Select Tracks</strong>
                    <br>
                    <small style="color:#929292;">
                        Select as many MP3, WAV, M4A, AAC or OGG files as you need.
                    </small>

                    <input id="newAlbumTracks"
                           type="file"
                           name="audio"
                           accept=".mp3,.wav,.m4a,.aac,.ogg"
                           multiple
                           required
                           style="display:block;margin-top:15px;">
                </label>

                <label style="border:1px dashed rgba(255,255,255,.15);padding:25px;border-radius:12px;cursor:pointer;">
                    <strong>▧ Album Artwork</strong>
                    <br>
                    <small style="color:#929292;">
                        JPG, PNG or WEBP
                    </small>

                    <input type="file"
                           name="cover"
                           accept=".jpg,.jpeg,.png,.webp"
                           required
                           style="display:block;margin-top:15px;">
                </label>

            </div>

            <div id="newAlbumTrackCount"
                 style="color:#c9a24a;margin-top:15px;">
                No tracks selected
            </div>

            <button type="submit"
                    class="admin-publish-button"
                    style="margin-top:20px;">
                ↑ CREATE ALBUM
            </button>

        </form>

    </div>


    <!-- EXISTING ALBUMS -->

    <div>
        <h2>Your Albums</h2>

        {% if albums %}

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px;margin-top:20px;">

            {% for album in albums %}

            <a href="{{ url_for('edit_album_manager', album_id=album['id']) }}"
               style="text-decoration:none;color:inherit;background:#111;border:1px solid rgba(255,255,255,.08);border-radius:16px;overflow:hidden;">

                {% if album['cover'] %}
                    <img src="{{ url_for('static', filename='images/' + album['cover']) }}"
                         style="width:100%;aspect-ratio:1;object-fit:cover;">
                {% else %}
                    <div style="width:100%;aspect-ratio:1;background:#181818;display:flex;align-items:center;justify-content:center;font-size:50px;">
                        ♪
                    </div>
                {% endif %}

                <div style="padding:18px;">
                    <h3 style="margin:0 0 6px;">
                        {{ album['title'] }}
                    </h3>

                    <div style="color:#929292;">
                        {{ album['artist'] }}
                    </div>

                    <div style="color:#c9a24a;margin-top:10px;">
                        {{ album['track_count'] }} tracks
                    </div>
                </div>

            </a>

            {% endfor %}

        </div>

        {% else %}

        <div style="padding:40px;background:#111;border-radius:15px;color:#929292;">
            No albums yet. Create your first album above.
        </div>

        {% endif %}

    </div>

</div>


<script>
const trackInput = document.getElementById("newAlbumTracks");
const trackCount = document.getElementById("newAlbumTrackCount");

trackInput.addEventListener("change", function () {

    const count = this.files.length;

    trackCount.textContent =
        count === 0
            ? "No tracks selected"
            : `${count} track${count === 1 ? "" : "s"} selected`;

});
</script>

{% endblock %}
