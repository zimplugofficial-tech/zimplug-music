/* =========================================================
   ZIMPLUG MUSIC — PROFESSIONAL INFORMATION FOOTER
   ========================================================= */

.zp-site-footer {
    margin-top: 100px;
    padding: 65px 24px 30px;
    background: #050505 !important;
    border-top: 1px solid rgba(255,255,255,.08);
}

.zp-footer-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 42px;
}

.zp-footer-logo a {
    display: block;
}

.zp-footer-logo img {
    width: 115px;
    max-height: 70px;
    object-fit: contain;
    display: block;
}

.zp-footer-logo span {
