.zp-footer-links a {
    min-height: 82px;
    padding: 19px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    text-decoration: none;

    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 10px;

    transition:
        border-color .2s ease,
        background .2s ease,
        transform .2s ease;
